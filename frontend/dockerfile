# Frontend Dockerfile - React + Node.js
FROM node:20.18.0 AS builder

WORKDIR /app

# Sin REACT_APP_BACKEND_URL (recomendado) la web llama a /api en su mismo dominio: el mismo build sirve
# para todos los clientes (en Coolify, /api del dominio va al backend). Con la variable, a esa URL
# (instancias viejas con el backend en otro dominio).
ARG REACT_APP_BACKEND_URL=
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
# Obsoleta: la ciudad de la factura se carga en Sistema › Configuración. Sólo respaldo de instancias viejas.
ARG REACT_APP_CIUDAD_FACTURA=
ENV REACT_APP_CIUDAD_FACTURA=$REACT_APP_CIUDAD_FACTURA

# Copiar package.json
COPY package.json ./

# Instalar dependencias (--legacy-peer-deps resuelve conflictos de react-scripts@5 + ajv)
RUN npm install --legacy-peer-deps

# Copiar código
COPY . .

# Build (REACT_APP_BACKEND_URL se embebe en el bundle estático)
RUN npm run build

# Stage 2: Servidor de producción
FROM node:20.18.0-alpine

WORKDIR /app

# Instalar serve
RUN npm install -g serve

# Crear usuario no-root
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

# Copiar build desde builder
COPY --from=builder --chown=nextjs:nodejs /app/build ./build

USER nextjs

# Exponer puerto
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Comando de inicio
CMD ["serve", "-s", "build", "-l", "3000"]
